rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName','createdAt','lastLoginAt','currentLevel',
             'totalStars','totalScore','unlockedLevels','completedLevels','settings'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 30
        && request.resource.data.currentLevel is int
        && request.resource.data.currentLevel >= 1 && request.resource.data.currentLevel <= 26
        && request.resource.data.totalStars is int
        && request.resource.data.totalStars >= 0 && request.resource.data.totalStars <= 78
        && request.resource.data.totalScore is int
        && request.resource.data.totalScore >= 0 && request.resource.data.totalScore <= 10000000
        && request.resource.data.unlockedLevels is list && request.resource.data.unlockedLevels.size() <= 26
        && request.resource.data.completedLevels is list && request.resource.data.completedLevels.size() <= 26
        && request.resource.data.settings is map;
    }

    match /progress/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['levels','updatedAt'])
        && request.resource.data.levels is map
        && request.resource.data.levels.size() <= 26;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
